set verbose off

function matrix holt_auto_init (series y "Target series")
    matrix ret = zeros(2, 1)

    # initial estimate of level, period 0
    ret[1] = y[$t1]

    # initial estimate of trend, period 0
    ret[2] = y[$t1+1] - y[$t1]

    # label the return vector
    rnameset(ret, "level trend")

    return ret
end function

function matrix holt_filter (const matrix theta, const matrix init,
                             const matrix my)
    # Run the Holt recursion over the column vector @my, given
    # @theta = (α, β) and @init = (level, trend) for period 0.
    # Returns a T x 4 matrix {y, level, trend, forecast}, where
    # forecast[t] is the one-step-ahead forecast made at t-1.
    #
    # The recursion is linear in the state s_t = (level_t, trend_t):
    #   s_t = A s_{t-1} + y_t * (α, αβ)'
    # so it can be run in one shot via varsimul().
    scalar α = theta[1]
    scalar β = theta[2]
    matrix A = {1-α, 1-α; -α*β, 1-α*β}
    matrix U = my .* {α, α*β}
    matrix S = varsimul(A, U, vec(init)')
    # S has T+1 rows: row 1 is the initializer
    matrix ret = my ~ S[2:,] ~ sumr(S[1:rows(S)-1,])
    return ret
end function

function scalar holt_crit (const matrix theta, const matrix my,
                           matrix *init)
    # BFGS callback: SSE given @theta = (α, β), with the initializer
    # concentrated out. Given (α, β) the one-step forecasts are linear
    # in the period-0 state: f = f0 + C * init, where f0 is the forecast
    # path from a zero initializer and the columns of C are the paths
    # from initializers (1,0) and (0,1). So the SSE-minimizing @init
    # is an OLS coefficient vector, written into @init.
    #
    # All three paths are run in one varsimul() call on a 6-variable
    # block-diagonal system.
    scalar α = theta[1]
    scalar β = theta[2]
    scalar T = rows(my)
    matrix A = {1-α, 1-α; -α*β, 1-α*β}
    matrix U = (my .* {α, α*β}) ~ zeros(T, 4)
    matrix S = varsimul(I(3) ** A, U, {0, 0, 1, 0, 0, 1})
    # forecasts: sum of lagged level and trend, for each subsystem
    matrix F = S[1:T,] * (I(3) ** {1; 1})
    matrix e
    matrix c = mols(my - F[,1], F[,2:3], &e)
    init[1] = c[1]
    init[2] = c[2]
    return sumc(e.^2)
end function

function matrix holt_auto_parms (const matrix my, matrix *init,
                                 int verbose)
    # driver for automatic estimation of parameters: BFGS over (α, β)
    # only, since the initializer is solved for exactly in holt_crit()
    matrix theta = {0.5; 0.5}
    matrix bounds = {1, 0, 1; 2, 0, 1}

    if verbose == 3
        set max_verbose full
    elif verbose == 2
        set max_verbose on
        set bfgs_verbskip 5
    endif
    catch scalar SSE = BFGScmin(&theta, bounds, holt_crit(theta, my, &init))
    err = $error
    if err
        printf "Got error %d from BFGScmin\n", err
        theta[1] = NA
    else
        # make sure @init corresponds to the final @theta
        SSE = holt_crit(theta, my, &init)
        if verbose > 0
            if verbose > 1
                printf "\n"
            endif
            printf "automatic parameter values:\n"
            printf "  α = %g, β = %g\n", theta[1], theta[2]
        endif
        if verbose > 0
            printf "\nestimated initializer:\n"
            printf "  level = %g, trend = %g\n\n", init[1], init[2]
        endif
    endif
    return theta
end function

function matrix smoother_ranges (const series y, int ntest)
    matrix ret = zeros(1,3)
    catch smpl --contiguous y
    if $error
        funcerr "Missing values encountered"
    endif
    ret[1] = $t1 # start of contiguous y
    ret[2] = $t2 # end of contiguous y
    scalar tail = $tmax - $t2
    if ntest > 0
        ret[2] = $t2 - ntest
        ret[3] = $t2
    elif tail > 0
        ret[3] = $tmax
    else
        ret[3] = $t2
    endif
    ntrain = ret[2] - ret[1] + 1
    errorif(ntrain < 4, "Insufficient observations for training")
    return ret
end function

function void holt_checks (const series y,
                           const matrix theta)
    if exists(theta)
        if nelem(theta) != 2
            funcerr "theta must be a 2-vector"
        else
            loop i=1..2
                errorif(theta[i] < 0 || theta[i] > 1,
                  sprintf("theta[%d] is out of bounds", i))
            endloop
        endif
    endif
end function

function void add_virtual_series (bundle *b)
    string s = sprintf("%s_level", b.yname)
    b[s] = "virtual_series:H[,2]"
    s = sprintf("%s_trend", b.yname)
    b[s] = "virtual_series:H[,3]"
    s = sprintf("%s_fcast", b.yname)
    b[s] = "virtual_series:H[,4]"
    s = sprintf("%s_irreg", b.yname)
    b[s] = "virtual_series:H[,1]-H[,4]"
end function

function void holt_add_eval_stats (bundle *b)
    scalar T = rows(b.H)
    scalar t0 = T - b.ntest + 1
    matrix e = b.H[t0:T,1] - b.H[t0:T,4]
    b.RMSE_test = sqrt(sumc(e.^2) / b.ntest)
    b.MAE_test = sumc(abs(e)) / b.ntest
end function

function bundle holt_default_args (void)
    bundle b
    b.theta = {0.5, 0.5}'
    b.ntest = 0
    b.verbose = 1
    b.bounds = _(verbose={0,3}, ntest={0,NA})
    return b
end function

function void check_ci_levels (matrix pc)
    scalar err = 0
    if nelem(pc) != 2
        err = 1
    elif min(pc) < 50 || max(pc) > 99
        err = 2
    elif pc[1] == pc[2]
        err = 3
    endif
    errorif(err, "ci_levels: invalid argument")
end function

function matrix Holt_ci_matrix (const bundle b,
                                matrix ci_levels[null])
    hmax = b.limits[3] - b.limits[2]
    errorif(hmax <= 0, "No post-training forecasts are available")
    if exists(ci_levels)
        check_ci_levels(ci_levels)
    else
        ci_levels = {80, 95}
    endif
    df = rows(b.H) - hmax - 4
    ci1 = min(ci_levels)
    ci2 = max(ci_levels)
    f1 = critical(t, df, (100 - ci1) / 200)
    f2 = critical(t, df, (100 - ci2) / 200)
    matrix CI = zeros(hmax, 4)
    t = rows(b.H) - hmax + 1
    scalar fc me
    loop i=1..hmax
        fc = b.H[t,4]
        me = f1 * b.H[t,5]
        CI[i,1] = fc - me
        CI[i,2] = fc + me
        me = f2 * b.H[t,5]
        CI[i,3] = fc - me
        CI[i,4] = fc + me
        t++
    endloop
    strings cs = array(4)
    cs[1] = sprintf("Lo%d", ci1)
    cs[2] = sprintf("Hi%d", ci1)
    cs[3] = sprintf("Lo%d", ci2)
    cs[4] = sprintf("Hi%d", ci2)
    cnameset(CI, cs)
    return CI
end function

function void holt_add_fcse (bundle *bh)
    # computes a sequence of Holt (AAN) forecast standard errors
    # see https://otexts.com/fpp3/ets-forecasting.html, # 8.7
    # and adds it to bundle b.
    # Note: the fpp3 formula is in terms of the ETS parametrization,
    # in which the trend smoothing parameter is α times our β
    # (fpp3 section 8.5)
    α = bh.theta[1]
    β = α * bh.theta[2]
    s2 = bh.RMSE_train^2
    hmax = bh.limits[3] - bh.limits[2]
    vh = ones(rows(bh.H), 1) * NA
    t = rows(vh) - hmax + 1
    loop h=1..hmax
        vh[t++] = s2 * (1 + (h-1)*(α^2 + α*β*h + (1/6)*β^2*h*(2*h-1)))
    endloop
    strings ss = cnameget(bh.H)
    bh.H ~= sqrt(vh)
    cnameset(bh.H, ss + "stderr")
end function

function bundle Holt (const series y,
                      const bundle specs[null])
    scalar fixed_theta = 0
    string yname = argname(y, "y")

    bundle args = holt_default_args()
    if exists(specs)
        fixed_theta = inbundle(specs, "theta")
        errorif(bcheck(&args, specs), "aborting")
    endif

    holt_checks(y, args.theta)
    scalar ntest = args.ntest

    matrix limits = smoother_ranges(y, ntest)
    scalar t1 = limits[1]
    scalar t2 = limits[2]
    scalar t3 = limits[3]
    smpl t1 t3

    scalar verbose = args.verbose
    series a b f
    list L = y a b f

    if verbose > 0
        printf "Holt double exponential smoothing\n"
        printf "Training range: %s to %s\n",
          obslabel(t1), obslabel(t2)
        if fixed_theta
            printf "Fixed parameters α = %g, β = %g\n",
              args.theta[1], args.theta[2]
        endif
        if args.ntest > 0
            printf "Testing forecast: %s to %s\n\n",
              obslabel(t2+1), obslabel(t3)
        elif t3 > t2
            printf "Out-of-sample forecast: %s to %s\n\n",
              obslabel(t2+1), obslabel(t3)
        else
            printf "Number of forecasts: 0\n\n"
        endif
    endif

    matrix init = holt_auto_init(y)
    if verbose > 1
        printf "initial level %g\n", init[1]
        printf "initial trend %g\n", init[2]
    endif

    # training data as a column vector
    smpl t1 t2
    matrix my = {y}
    smpl t1 t3

    if fixed_theta
        matrix theta = args.theta
    else
        matrix theta = holt_auto_parms(my, &init, verbose)
        if !ok(theta[1])
            funcerr "Failed to estimate parameters"
        endif
    endif
    theta = vec(theta)

    # training: states and one-step-ahead forecasts
    matrix Htr = holt_filter(theta, init, my)
    matrix u = Htr[,1] - Htr[,4]
    scalar n = rows(u)
    scalar RMSE_train = sqrt(sumc(u.^2) / n)
    scalar MAE_train = sumc(abs(u)) / n

    # transcribe to series over t1..t2
    smpl t1 t2
    a = Htr[,2]
    b = Htr[,3]
    f = Htr[,4]

    # h-step-ahead forecasts over t2+1..t3 (test or out-of-sample)
    if t3 > t2
        smpl t2+1 t3
        f = Htr[n,2] + seq(1, t3-t2)' * Htr[n,3]
    endif
    smpl t1 t3

    # use the same names whether or not we're printing, so that
    # Holt_plot() and other consumers of H always find them
    rename a level
    rename b trend
    rename f forecast

    if verbose > 0
        if verbose > 1
            printf "\n"
        endif
        printf "training RMSE = %g, MAE = %g\n", RMSE_train, MAE_train
        print L -o
    endif

    set skip_missing off
    matrix H = {L}
    bundle ret = _(theta, init, ntest, H, RMSE_train, MAE_train,
      yname, limits)

    if ntest > 0
        holt_add_eval_stats(&ret)
        if verbose > 0
            printf "testing RMSE = %g, MAE = %g\n", ret.RMSE_test,
              ret.MAE_test
        endif
    endif

    if verbose > 0
        printf "\n"
    endif
    if ret.limits[3] > ret.limits[2]
        holt_add_fcse(&ret)
    endif
    if $version >= 20262
        add_virtual_series(&ret)
    endif

    return ret
end function

function bundles ci_bands (list L, int df, scalar c1, scalar c2)
    bundles bb = array(2)
    # for plotting, show the wider band first
    f1 = critical(t, df, (100 - c2) / 200)
    f2 = critical(t, df, (100 - c1) / 200)
    bb[1] = _(center="forecast", width="stderr", factor=f1, style="fill", color="#BBD9F5")
    bb[2] = _(center="forecast", width="stderr", factor=f2, style="fill", color="#6AADEC")
    return bb
end function

function void Holt_plot (const bundle *b,
                         int ptype[1:2:1] {"actual and forecast", "components"},
                         matrix ci_levels[null])
    list L = mat2list(b.H)
    if ptype == 1
        string yname = b.yname
        if yname != "y"
            rename y @yname
        endif
        if b.limits[3] > b.limits[2]
            if exists(ci_levels)
                check_ci_levels(ci_levels)
            else
                ci_levels = {80, 95}
            endif
            hmax = b.limits[3] - b.limits[2]
            c1 = min(ci_levels)
            c2 = max(ci_levels)
            df = rows(b.H) - hmax - 4
            hbands = ci_bands(L, df, c1, c2)
            list P = @yname forecast
            plot P
                options --time-series --with-lines --bands=hbands
                printf "set title 'forecast with %d and %d percent intervals'",
                  c1, c2
            end plot --output=display
        else
            gnuplot @yname forecast --time --with-lines --output=display
        endif
    else
        series irreg = b.H[,1] - b.H[,4]
        tsplots level trend irreg --output=display
    endif
end function

function scalar holt_precheck (void)
    # return non-zero if dataset is not suitable:
    # we require sufficient observations
    return $nobs < 10
end function

function bundle holt_ui_maker (void)
    bundle b
    b.alpha = _(depends="parms=2")
    b.beta  = _(depends="parms=2")
    return b
end function

function bundle Holt_gui (series y,
                          int parms[1:2:1] {"automatic", "pre-specified"},
                          scalar alpha[0:1:0.2:0.0001] "level, α",
                          scalar  beta[0:1:0.2:0.0001] "trend, β",
                          int ntest[0::0] "ntest, see Help",
                          int verbose[0:3:1])
    string yname = argname(y, "y")
    if yname != "y"
        rename y @yname
    endif
    bundle ret
    if parms == 1
        ret = Holt(@yname, _(ntest, verbose))
    else
        matrix theta = {alpha, beta}'
        ret = Holt(@yname, _(theta, ntest, verbose))
    endif
    return ret
end function

