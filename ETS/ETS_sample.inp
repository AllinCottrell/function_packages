include ETS.gfn

# simple exponential smoothing: no trend, no seasonality
open alg_exports.gdt --frompkg=ETS
dataset addobs 5
bundle sb = ETS(Exports)
ETS_plot(&sb, 1)

# Holt: linear trend
open auspop.gdt --frompkg=ETS
dataset addobs 10
bundle hb = ETS(pop, _(trend=1))
ETS_plot(&hb, 1)
ETS_plot(&hb, 2)

# Holt-Winters, with 12 out-of-sample forecasts
open aus_holidays.gdt --frompkg=ETS
dataset addobs 12
bundle wb = ETS(Trips, _(seasonal=1))
ETS_plot(&wb, 1)
ETS_plot(&wb, 2)
