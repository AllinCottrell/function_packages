set verbose off

function matrix winters_auto_init (series y "Target series",
                                   bool additive)
   scalar m = $pd
   scalar t2 = $t1+m-1
   scalar am1 = 0
   scalar am2 = 0
   scalar bm = 0
   matrix ret = zeros(m + 2, 1)

   # sums of y over the first two major periods
   loop t=$t1..t2
      am1 += y[t]
      am2 += y[t + m]
   endloop

   # initial estimate of level: 1st major period average
   ret[1] = am1 / m

   # initial estimate of trend
   ret[2] = (am2 - am1) / (m * m)

   # seasonal indices
   i = 3
   loop t=$t1..t2
      if additive
         # deviation from average
         ret[i] = y[t] - ret[1]
      else
         # ratio relative to average
         ret[i] = y[t] / ret[1]
      endif
      i++
   endloop

   # label the return vector
   strings S = array(2 + m)
   S[1] = "level"
   S[2] = "trend"
   loop i=1..m
      S[i+2] = sprintf("seas%d", i)
   endloop
   rnameset(ret, S)

   return ret
end function

# ------------------------------------------------------------------
# Additive case: the recursion is linear in the state
#   z_t = (a_t, b_t, s_t, s_{t-1}, ..., s_{t-m+1})'
# so  z_t = A z_{t-1} + d y_t,  and the one-step forecast is
#   f_t = c'z_{t-1} = a_{t-1} + b_{t-1} + s_{t-m}.
# ------------------------------------------------------------------

function matrix winters_A (const matrix theta, int m)
   scalar α = theta[1]
   scalar β = theta[2]
   scalar γ = theta[3]
   scalar n = m + 2
   matrix A = zeros(n, n)
   A[1,1] = 1-α
   A[1,2] = 1-α
   A[1,n] = -α
   A[2,1] = -α*β
   A[2,2] = 1-α*β
   A[2,n] = -α*β
   A[3,1] = -γ*(1-α)
   A[3,2] = -γ*(1-α)
   A[3,n] = 1-γ*(1-α)
   loop j=4..n
      # shift the older seasonals down one slot
      A[j,j-1] = 1
   endloop
   return A
end function

function matrix winters_d (const matrix theta, int m)
   # loading of y_t on the state (row vector)
   scalar α = theta[1]
   return {α, α*theta[2], theta[3]*(1-α)} ~ zeros(1, m-1)
end function

function matrix winters_c (int m)
   # forecast selection vector
   return {1; 1} | zeros(m-1, 1) | 1
end function

function matrix winters_filter_add (const matrix theta, const matrix init,
                                    const matrix my)
   # returns T x 5 matrix {y, level, trend, seasonal, forecast}
   scalar m = nelem(init) - 2
   scalar T = rows(my)
   # state order is newest seasonal first; @init is oldest first
   matrix z0 = init[1:2] | mreverse(init[3:m+2])
   matrix Z = varsimul(winters_A(theta, m), my * winters_d(theta, m), z0')
   return my ~ Z[2:T+1,1:3] ~ Z[1:T,] * winters_c(m)
end function

function scalar winters_crit_add (const matrix theta, const matrix my,
                                  matrix *init)
   # BFGS callback, additive case: SSE given @theta = (α, β, γ), with
   # the initial state concentrated out. Forecasts are linear in the
   # initial state, f = f0 + G z0, where f0 is the forecast path from a
   # zero state and row t of G is c'A^(t-1). Note that G can be had
   # from one varsimul() call with transition A' and initial value c.
   #
   # Seasonals are constrained to sum to zero: the initial level and
   # the seasonal mean are not separately identified (adding k to the
   # level and subtracting k from every seasonal leaves all forecasts
   # unchanged), so without this the regressors would be collinear.
   scalar m = nelem(init) - 2
   scalar T = rows(my)
   matrix A = winters_A(theta, m)
   matrix c = winters_c(m)
   matrix Z = varsimul(A, my * winters_d(theta, m), zeros(1, m+2))
   matrix f0 = Z[1:T,] * c
   matrix G = varsimul(A', zeros(T-1, m+2), c')
   # put seasonal columns in @init order (oldest first)
   matrix X = G[,1:2] ~ mreverse(G[,3:m+2]')'
   # impose seas_m = -(seas_1 + ... + seas_{m-1})
   matrix Xs = X[,1:m+1] - X[,m+2] * ({0, 0} ~ ones(1, m-1))
   matrix e
   matrix q = mols(my - f0, Xs, &e)
   init[1:m+1] = q
   init[m+2] = -sumc(q[3:m+1])
   return sumc(e.^2)
end function

# ------------------------------------------------------------------
# Multiplicative case: nonlinear, so we need an explicit loop, but
# on matrices rather than series and with no per-step branching.
# ------------------------------------------------------------------

function matrix winters_filter_mult (const matrix theta, const matrix init,
                                     const matrix my)
   # returns T x 5 matrix {y, level, trend, seasonal, forecast}
   scalar α = theta[1]
   scalar β = theta[2]
   scalar γ = theta[3]
   scalar m = nelem(init) - 2
   scalar T = rows(my)
   # s[t] holds s_{t-m}; s[t+m] receives s_t
   matrix s = init[3:m+2] | zeros(T, 1)
   matrix ret = my ~ zeros(T, 4)
   scalar a_ = init[1]
   scalar b_ = init[2]
   scalar a = 0
   scalar b = 0
   scalar sm = 0
   loop t=1..T
      sm = s[t]
      ret[t,5] = (a_ + b_) * sm
      a = α * my[t] / sm + (1-α) * (a_ + b_)
      b = β * (a - a_) + (1-β) * b_
      s[t+m] = γ * my[t] / a + (1-γ) * sm
      ret[t,2] = a
      ret[t,3] = b
      a_ = a
      b_ = b
   endloop
   ret[,4] = s[m+1:m+T]
   return ret
end function

function matrix winters_mult_init (const matrix par, int m)
   # map (α, β, γ, level, trend, seas_1..seas_{m-1}) to the full
   # initializer, with seasonals normalized to average 1: scaling
   # level and trend by k and the seasonals by 1/k leaves all
   # forecasts unchanged, so one seasonal is redundant
   matrix sv = par[6:m+4]
   return par[4:5] | sv | (m - sumc(sv))
end function

function scalar winters_crit_mult (const matrix par, const matrix my,
                                   int m)
   # BFGS callback, multiplicative case
   matrix W = winters_filter_mult(par[1:3], winters_mult_init(par, m), my)
   return sumc((W[,1] - W[,5]).^2)
end function

function matrix winters_filter (const matrix theta, const matrix init,
                                const matrix my, bool additive)
   if additive
      return winters_filter_add(theta, init, my)
   else
      return winters_filter_mult(theta, init, my)
   endif
end function

function matrix winters_auto_parms (const matrix my, matrix *init,
                                    bool additive, int verbose)
   # driver for automatic estimation of parameters
   scalar m = nelem(init) - 2
   matrix b = {0.2; 0.2; 0.05}
   if !additive
      # the additive case solves for the initializer internally
      b |= init[1:m+1]
   endif
   scalar len = nelem(b)
   matrix bounds = zeros(len, 3)
   loop i=1..len
      if i < 4
         bounds[i,] = {i, 0, 1}
      else
         bounds[i,] = {i, -$huge, $huge}
      endif
   endloop

   if verbose == 3
      set max_verbose full
   elif verbose == 2
      set max_verbose on
      set bfgs_verbskip 5
   endif
   if additive
      catch scalar SSE = BFGScmin(&b, bounds, winters_crit_add(b, my, &init))
   else
      catch scalar SSE = BFGScmin(&b, bounds, winters_crit_mult(b, my, m))
   endif
   err = $error
   if err
      printf "Got error %d from BFGScmin\n", err
      b[1] = NA
   else
      # make sure @init corresponds to the final parameters
      if additive
         SSE = winters_crit_add(b, my, &init)
      else
         init[1:m+2] = winters_mult_init(b, m)
      endif
      if verbose > 0
         printf "automatic parameter values:\n"
         printf "  α = %g, β = %g, γ = %g\n", b[1], b[2], b[3]
         printf "\nestimated initializer:\n\n"
         eval init
      endif
   endif
   return b[1:3]
end function

function scalar winters_given_theta (const matrix theta, const matrix my,
                                     matrix *init, bool additive,
                                     int verbose)
   # optimize the initializer conditional on fixed @theta
   scalar m = nelem(init) - 2
   if additive
      # the initializer is concentrated out by OLS
      winters_crit_add(theta, my, &init)
   else
      matrix b = init[1:m+1]
      if verbose == 3
         set max_verbose full
      elif verbose == 2
         set max_verbose on
         set bfgs_verbskip 5
      endif
      catch scalar SSE = BFGSmin(&b, winters_crit_mult(theta | b, my, m))
      err = $error
      if err
         printf "Got error %d from BFGSmin\n", err
         return err
      endif
      init[1:m+2] = winters_mult_init(theta | b, m)
   endif
   if verbose > 0
      printf "estimated initializer, given θ:\n\n"
      eval init
   endif
   return 0
end function

function matrix winters_ranges (const series y, int ntest)
   matrix ret = zeros(1,3)
   catch smpl --contiguous y
   if $error
      funcerr "Missing values encountered"
   endif
   ret[1] = $t1 # start of contiguous y
   ret[2] = $t2 # end of contiguous y
   scalar tail = $tmax - $t2
   if ntest > 0
      ret[2] = $t2 - ntest
      ret[3] = $t2
   elif tail > 0
      ret[3] = $tmax
   else
      ret[3] = $t2
   endif
   ntrain = ret[2] - ret[1] + 1
   errorif(ntrain < 4 * $pd,
     "Insufficient observations for training")
   return ret
end function

function void winters_checks (const series y,
                              const matrix theta)
   if $pd == 1
      funcerr "Periodicity = 1, no seasonality!"
   endif
   if exists(theta)
      if nelem(theta) != 3
         funcerr "theta must be a 3-vector"
      else
         loop i=1..3
            errorif(theta[i] < 0 || theta[i] > 1,
              sprintf("theta[%d] is out of bounds", i))
         endloop
      endif
   endif
end function

function void add_virtual_series (bundle *b)
   string s = sprintf("%s_level", b.yname)
   b[s] = "virtual_series:W[,2]"
   s = sprintf("%s_trend", b.yname)
   b[s] = "virtual_series:W[,3]"
   s = sprintf("%s_season", b.yname)
   b[s] = "virtual_series:W[,4]"
   s = sprintf("%s_fcast", b.yname)
   b[s] = "virtual_series:W[,5]"
   s = sprintf("%s_irreg", b.yname)
   b[s] = "virtual_series:W[,1]-W[,5]"
end function

function void winters_add_eval_stats (bundle *b)
   scalar T = rows(b.W)
   scalar t0 = T - b.ntest + 1
   matrix e = b.W[t0:T,1] - b.W[t0:T,5]
   b.RMSE_test = sqrt(sumc(e.^2) / b.ntest)
   b.MAE_test = sumc(abs(e)) / b.ntest
end function

function void winters_add_fcse (bundle *b)
   # forecast standard errors for additive Holt-Winters, using the
   # equivalent ETS(A,A,A) model: https://otexts.com/fpp3/ets-forecasting.html
   # Table 8.8. The ETS smoothing parameters are related to ours by
   # β_ets = αβ and γ_ets = (1-α)γ (see fpp3 sections 8.3 and 8.5).
   scalar m = nelem(b.init) - 2
   scalar α = b.theta[1]
   scalar β = α * b.theta[2]
   scalar γ = (1-α) * b.theta[3]
   scalar s2 = b.RMSE_train^2
   scalar hmax = b.limits[3] - b.limits[2]
   matrix vh = ones(rows(b.W), 1) * NA
   scalar t = rows(vh) - hmax + 1
   loop h=1..hmax
      k = floor((h-1)/m)
      vh[t++] = s2 * (1 + (h-1)*(α^2 + α*β*h + (1/6)*β^2*h*(2*h-1)) \
        + γ*k*(2*α + γ + β*m*(k+1)))
   endloop
   strings ss = cnameget(b.W)
   b.W ~= sqrt(vh)
   cnameset(b.W, ss + "stderr")
end function

function bundle winters_default_args (void)
   bundle b
   b.theta = {0.5, 0.5, 0.05}'
   b.additive = 0
   b.ntest = 0
   b.verbose = 1
   b.bounds = _(additive={0,1}, verbose={0,3}, ntest={0,NA})
   return b
end function

function bundle Winters (const series y,
                         const bundle specs[null])
   scalar m = $pd
   scalar fixed_theta = 0
   string yname = argname(y, "y")

   bundle args = winters_default_args()
   if exists(specs)
      fixed_theta = inbundle(specs, "theta")
      errorif(bcheck(&args, specs), "aborting")
   endif

   winters_checks(y, args.theta)
   scalar ntest = args.ntest

   matrix limits = winters_ranges(y, ntest)
   scalar t1 = limits[1]
   scalar t2 = limits[2]
   scalar t3 = limits[3]
   smpl t1 t3

   scalar additive = args.additive
   scalar verbose = args.verbose
   series a b s f
   list L = y a b s f

   if verbose > 0
      printf "Winters, using %s formula\n", \
        additive ? "additive" : "multiplicative"
      printf "Recursion runs from %s to %s\n",
        obslabel(t1), obslabel(t2)
      if args.ntest > 0
         printf "Intra-sample forecast: %s to %s\n\n",
           obslabel(t2+1), obslabel(t3)
      elif t3 > t2
         printf "Out-of-sample forecast: %s to %s\n\n",
           obslabel(t2+1), obslabel(t3)
      else
         printf "Number of forecasts: 0\n\n"
      endif
   endif

   matrix init = winters_auto_init(y, additive)
   if verbose > 1
      print init
   endif

   # training data as a column vector
   smpl t1 t2
   matrix my = {y}
   smpl t1 t3

   if fixed_theta
      matrix theta = vec(args.theta)
      err = winters_given_theta(theta, my, &init, additive, verbose)
      if err
         funcerr "Failed to optimize initializer"
      endif
   else
      matrix theta = winters_auto_parms(my, &init, additive, verbose)
      if !ok(theta[1])
         funcerr "Failed to estimate parameters"
      endif
   endif
   theta = vec(theta)

   # training: states and one-step-ahead forecasts
   matrix Wtr = winters_filter(theta, init, my, additive)
   matrix u = Wtr[,1] - Wtr[,5]
   scalar n = rows(u)
   scalar SSE = sumc(u.^2)
   scalar RMSE_train = sqrt(SSE / n)
   scalar MAE_train = sumc(abs(u)) / n

   smpl t1 t2
   a = Wtr[,2]
   b = Wtr[,3]
   s = Wtr[,4]
   f = Wtr[,5]

   # h-step-ahead forecasts over t2+1..t3
   if t3 > t2
      scalar H = t3 - t2
      matrix hv = seq(1, H)'
      # last m seasonals, cycled out to H periods
      matrix sh = Wtr[n-m+1:n,4] * ones(1, ceil(H/m))
      sh = vec(sh)[1:H]
      smpl t2+1 t3
      if additive
         f = Wtr[n,2] + hv * Wtr[n,3] + sh
      else
         f = (Wtr[n,2] + hv * Wtr[n,3]) .* sh
      endif
   endif
   smpl t1 t3

   # use the same names whether or not we're printing,
   # so Winters_plot() always finds them
   rename a level
   rename b trend
   rename s seasonal
   rename f forecast

   if verbose > 0
      printf "training SSE = %g, RMSE = %g, MAE = %g\n", SSE,
        RMSE_train, MAE_train
      print L -o
   endif

   set skip_missing off
   matrix W = {L}
   bundle ret = _(theta, init, additive, ntest, W, RMSE_train,
     MAE_train, yname, limits)

   if ntest > 0
      winters_add_eval_stats(&ret)
      if verbose > 0
         printf "testing RMSE = %g, MAE = %g\n", ret.RMSE_test,
           ret.MAE_test
      endif
   endif

   if verbose > 0
      printf "\n"
   endif
   if $version >= 20262
      add_virtual_series(&ret)
   endif
   if additive && t3 > t2
      winters_add_fcse(&ret)
   endif

   return ret
end function

function bundles ci_bands (list L, int df, scalar c1, scalar c2)
   bundles bb = array(2)
   # for plotting, show the wider band first
   f1 = critical(t, df, (100 - c2) / 200)
   f2 = critical(t, df, (100 - c1) / 200)
   bb[1] = _(center="forecast", width="stderr", factor=f1, style="fill", color="#BBD9F5")
   bb[2] = _(center="forecast", width="stderr", factor=f2, style="fill", color="#6AADEC")
   return bb
end function

function void get_ci_vals (const bundle b, matrix ci_levels[null],
                           scalar *c1, scalar *c2, scalar *hmax)
   if exists(ci_levels)
      check_ci_levels(ci_levels)
   else
      ci_levels = {80, 95}
   endif
   hmax = b.limits[3] - b.limits[2]
   c1 = min(ci_levels)
   c2 = max(ci_levels)
end function

function void Winters_plot (const bundle *b,
                            int ptype[1:2:1] {"actual and forecast", "components"},
                            matrix ci_levels[null])
   list L = mat2list(b.W)
   if ptype == 1
      string yname = b.yname
      if yname != "y"
         rename y @yname
      endif
      if b.limits[3] > b.limits[2] && b.additive
         scalar c1 c2 hmax
         get_ci_vals(b, ci_levels, &c1, &c2, &hmax)
         df = rows(b.W) - hmax - (4 + $pd)
         hbands = ci_bands(L, df, c1, c2)
         list P = @yname forecast
         plot P
            options --time-series --with-lines --bands=hbands
            printf "set title 'forecast with %d and %d percent intervals'",
              c1, c2
         end plot --output=display
      else
         gnuplot @yname forecast --time --with-lines --output=display
      endif
   else
      series irreg = b.W[,1] - b.W[,5]
      tsplots level trend seasonal irreg --output=display
   endif
end function

function scalar winters_precheck (void)
   # return non-zero if dataset is not suitable:
   # we require $pd > 1 and sufficient observations
   return $pd == 1 || $nobs < 4 * $pd
end function

function bundle winters_ui_maker (void)
   bundle b
   b.alpha = _(depends="parms=2")
   b.beta  = _(depends="parms=2")
   b.gamma = _(depends="parms=2")
   return b
end function

function bundle Winters_gui (series y,
                             int parms[1:2:1] {"automatic", "pre-specified"},
                             scalar alpha[0:1:0.2:0.0001] "level, α",
                             scalar  beta[0:1:0.2:0.0001] "trend, β",
                             scalar gamma[0:1:0.05:0.0001] "season, γ",
                             int formula[1:2:2] {"additive", "multiplicative"},
                             int ntest[0::0] "ntest, see Help",
                             int verbose[0:3:1])
   scalar additive = formula == 1
   string yname = argname(y, "y")
   if yname != "y"
      rename y @yname
   endif
   bundle ret
   if parms == 1
      ret = Winters(@yname, _(additive, ntest, verbose))
   else
      matrix theta = {alpha, beta, gamma}
      ret = Winters(@yname, _(theta, additive, ntest, verbose))
   endif
   return ret
end function
