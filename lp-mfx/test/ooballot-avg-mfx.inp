include lp-mfx.gfn

open ooballot -q

# restrict to 'P' and 'O' countries
smpl Status > 0 --restrict

# ordered probit
probit Vote 0 CPI Status
bundle b = lp_mfx($model, 2, 0)
lp_mfx_print(&b)
# print b
# quit

foreign language=stata --send-data
  oprobit vote cpi status
  margins, dydx(cpi status) predict(outcome(0))
  margins, dydx(cpi status) predict(outcome(1))
  margins, dydx(cpi status) predict(outcome(2))
end foreign


